# 이 파일을 server/.env 로 복사하세요. 실제 키/비밀번호를 Git에 올리지 마세요.
KLINK_DEMO_USER=klink
KLINK_DEMO_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_PASSWORD
KLINK_DEMO_NAME=K:LINK 시연 관리자
# 서버에만 저장. 브라우저의 VITE_ 환경변수에 넣지 마세요.
OPENAI_API_KEY=
KLINK_LLM_MODEL=gpt-4.1-mini
# openai: text-embedding-3-small Dense / local: BAAI/bge-m3 Dense (추가 패키지 필요)
KLINK_EMBED_PROVIDER=openai
KLINK_EMBED_MODEL=text-embedding-3-small
KLINK_LOCAL_MODEL=BAAI/bge-m3
KLINK_MIN_SCORE=0.25
KLINK_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# HTTPS 공개 배포 시 true; 단독 데모 서버를 공개 인터넷에 노출하지 마세요.
KLINK_SECURE_COOKIE=false
# KLINK_DATA_DIR=/absolute/private/path
